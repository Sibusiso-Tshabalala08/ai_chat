
<Window x:Class="demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="AI Cybersecurity Chatbot" Height="450" Width="800"
        MinHeight="450" MinWidth="800">

    <!-- Outer container grid that holds all three page grids -->
    <Grid>

        <!-- 
            HOME GRID
            This is the first page the user sees when they launch the app.
            It shows the logo, a welcome message, and a proceed button.
            Visible by default on startup.
        -->
        <Grid x:Name="home_grid" Visibility="Visible" Background="#080C1E">

            <!-- App logo displayed at the top center of the home page -->
            <Image 
                Source="/cybersecurity.jpeg" 
                Height="200"
                Width="300"
                Margin="0,0,0,200"/>

            <!-- Welcome message shown below the logo -->
            <TextBlock
                Text="Welcome to AI Cybersecurity Chatbot"
                Height="20"
                Width="270"
                TextAlignment="Center"
                Margin="0,30,0,0"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#00BFFF"/>

            <!-- 
                Proceed button that navigates the user to the username page
                Calls the proceed event handler in MainWindow.xaml.cs
            -->
            <Button 
                Height="60"
                Width="300"
                Margin="0,200,0,0"
                Content="Proceed"
                Click="proceed"
                Background="#0A1A3A"
                Foreground="#00BFFF"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="Bold"
                BorderBrush="#00BFFF"
                BorderThickness="1"
                Cursor="Hand"/>

        </Grid>


        <!-- 
            USERNAME GRID
            This is the second page where the user enters their username.
            It is hidden by default and only shown after clicking Proceed.
            Contains an input field, error message, and submit button.
        -->
        <Grid x:Name="username_grid" Visibility="Hidden" Background="#080C1E">

            <!-- App logo shown again on the username page for consistency -->
            <Image 
                Source="/cybersecurity.jpeg" 
                Height="200"
                Width="300"
                Margin="0,0,0,200"/>

            <!-- Instruction label telling the user what to do -->
            <TextBlock
                Text="Please enter username"
                Height="20"
                Width="270"
                TextAlignment="Justify"
                Margin="0,30,0,0"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#00BFFF"/>

            <!-- Text input where the user types their username -->
            <TextBox
                Height="40"
                Width="270"
                TextAlignment="Center"
                Margin="0,100,0,0"
                FontFamily="Segoe UI"
                FontSize="13"
                x:Name="usernames_input"
                Background="#0A1A3A"
                Foreground="#C8DCFF"
                CaretBrush="#00BFFF"
                BorderBrush="#00BFFF"
                BorderThickness="1"/>

            <!-- 
                Error message shown only when user tries to submit an empty username
                Hidden by default — toggled visible in MainWindow.xaml.cs submit_name method
            -->
            <TextBlock
                x:Name="error_text"
                Text="Please enter a username to continue..."
                Height="20"
                Width="270"
                TextAlignment="Justify"
                Margin="0,180,0,0"
                Foreground="#FF4C6A"
                FontFamily="Segoe UI"
                FontSize="12"
                Visibility="Hidden"/>

            <!-- 
                Submit button that saves the username and navigates to the chat page
                Calls the submit_name event handler in MainWindow.xaml.cs
            -->
            <Button 
                Height="40"
                Width="270"
                Margin="0,250,0,0"
                Content="Submit Username"
                Click="submit_name"
                Background="#0A1A3A"
                Foreground="#00BFFF"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="Bold"
                BorderBrush="#00BFFF"
                BorderThickness="1"
                Cursor="Hand"/>

        </Grid>


        <!-- 
            CHAT GRID
            This is the main chat interface where the user talks to the chatbot.
            Hidden by default and shown after the username is submitted.
            Contains the message list, input box, and send button.
        -->
        <Grid x:Name="chat_grid" Visibility="Hidden" Background="#080C1E">

            <!-- 
                ListView that displays all chat messages between user and chatbot
                Messages are added dynamically as Border elements in the code behind
            -->
            <ListView  
                x:Name="chats" 
                Height="300"
                Margin="0,0,0,120"
                Background="#0A0E27"
                BorderBrush="#1E64DC"
                BorderThickness="1"
                Foreground="#C8DCFF"
                FontFamily="Segoe UI"
                FontSize="13"/>

            <!-- 
                KeyDown added so pressing Enter sends the message
                TextChanged added to show or hide the placeholder hint
                Text input where the user types their cybersecurity question
            -->
            <TextBox
                x:Name="question"
                Height="50"
                Width="480"
                Margin="0,300,300,0"
                Background="#0A1A3A"
                Foreground="#C8DCFF"
                CaretBrush="#00BFFF"
                BorderBrush="#00BFFF"
                BorderThickness="1"
                FontFamily="Segoe UI"
                FontSize="13"
                KeyDown="question_KeyDown"
                TextChanged="question_TextChanged"/>

            <!-- 
                Placeholder hint text overlaid on the question TextBox
                IsHitTestVisible="False" means clicks pass through it to the TextBox
                Hidden automatically when the user starts typing
            -->
            <TextBlock
                x:Name="placeholder_hint"
                Text="Ask me a cybersecurity question..."
                IsHitTestVisible="False"
                Foreground="#4A6080"
                FontFamily="Segoe UI"
                FontSize="13"
                Height="50"
                Width="480"
                Margin="5,300,300,0"
                VerticalAlignment="Center"/>

            <!-- 
                Send button that submits the user's question to the chatbot
                Calls the send event handler in MainWindow.xaml.cs
            -->
            <Button
                Height="50"
                Width="280"
                Margin="490,300,0,0"
                Content="Send"
                Click="send"
                Background="#0A1A3A"
                Foreground="#00BFFF"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="Bold"
                BorderBrush="#00BFFF"
                BorderThickness="1"
                Cursor="Hand"/>

        </Grid>

    </Grid>
</Window>